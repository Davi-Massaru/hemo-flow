zn "USER"
do $system.OBJ.Load("/opt/hemoflow/tools/ToolProbe.cls","ck")
set config=##class(%DynamicObject).%FromJSON(##class(HemoFlow.AIHubDecisionOperation).Configuration())
set provider=##class(%AI.Provider).Create("openai",config)
set agent=##class(%AI.Agent).%New(provider)
set agent.Model=config.%Get("model"),agent.MaxIterations=4
set agent.SystemPrompt="Call both EchoNative and EchoPython with value ok, then return compact JSON without markdown fences."
write "AI_TOOL init ",agent.%Init(),!
write "AI_TOOL attach ",agent.UseToolSet("HemoFlow.ToolProbe"),!
set session=agent.CreateSession({"timeout_ms":30000,"max_tokens":100})
write "AI_TOOL chat",!
set result=agent.Chat(session,"Test both echo tools.")
write "AI_TOOL result ",result.Content,!
halt
